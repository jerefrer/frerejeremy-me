{% from "macros.njk" import t, ext %}<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title data-fr="{{ texts.site.title.fr }}">{{ texts.site.title.en }}</title>
    <meta name="description" content="{{ texts.site.description.en }}" data-fr="{{ texts.site.description.fr }}"/>
    <link rel="canonical" href="https://frerejeremy.me/"/>
    <meta name="theme-color" content="#ffffff"/>
    <meta name="color-scheme" content="light"/>

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="Frère Jérémy"/>
    <meta property="og:title" content="{{ texts.site.title.en }}"/>
    <meta property="og:description" content="{{ texts.site.description.en }}"/>
    <meta property="og:url" content="https://frerejeremy.me/"/>
    <meta property="og:image" content="https://frerejeremy.me/assets/images/og-image.jpg"/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Frère Jérémy: open source tools for the Dharma and compassionate initiatives"/>
    <meta property="og:locale" content="en_US"/>
    <meta property="og:locale:alternate" content="fr_FR"/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content="{{ texts.site.title.en }}"/>
    <meta name="twitter:description" content="{{ texts.site.description.en }}"/>
    <meta name="twitter:image" content="https://frerejeremy.me/assets/images/og-image.jpg"/>

    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png"/>
    <link rel="manifest" href="/assets/favicon/site.webmanifest"/>

    <link rel="preload" href="/assets/fonts/literata-latin.woff2" as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href="/assets/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin/>
    <link rel="stylesheet" href="/assets/css/site.css"/>

    <script>
      // Pick the language before first paint so there is no flash of the wrong one.
      (function () {
        var lang = "en";
        try {
          var saved = localStorage.getItem("preferredLanguage");
          if (saved === "en" || saved === "fr") lang = saved;
          else if ((navigator.language || "").slice(0, 2) === "fr") lang = "fr";
        } catch (e) {}
        document.documentElement.lang = lang;
      })();
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jérémy Frère",
      "alternateName": "Frère Jérémy",
      "url": "https://frerejeremy.me/",
      "image": "https://frerejeremy.me/assets/favicon/android-chrome-512x512.png",
      "description": "{{ texts.site.description.en }}",
      "sameAs": ["https://github.com/jerefrer"]
    }
    </script>
    <!-- Matomo -->
    <script>
      var _paq = (window._paq = window._paq || []);
      _paq.push(["trackPageView"]);
      _paq.push(["enableLinkTracking"]);
      (function () {
        var u = "//analytics.frerejeremy.me/";
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "1"]);
        var d = document,
          g = d.createElement("script"),
          s = d.getElementsByTagName("script")[0];
        g.async = true;
        g.src = u + "matomo.js";
        s.parentNode.insertBefore(g, s);
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip" href="#main"><span lang="en">Skip to content</span><span lang="fr">Aller au contenu</span></a>

    <header class="site-header wrap">
      <a class="brand" href="#top">
        <img src="/assets/favicon/android-chrome-192x192.png" alt="" width="44" height="44"/>
        <span>Frère Jérémy</span>
      </a>
      <div class="header-end">
        <nav class="nav" aria-label="{{ texts.nav.label.en }}">
          <a href="#tools">{{ t(texts.nav.tools) }}</a>
          <a href="#apps">{{ t(texts.nav.apps) }}</a>
          <a href="#work">{{ t(texts.nav.work) }}</a>
          <a href="#support" class="nav-support">{{ t(texts.nav.support) }}</a>
        </nav>
        <div class="lang" role="group" aria-label="Language / Langue">
          <button type="button" data-set-lang="en" lang="en" aria-label="English">EN</button>
          <span aria-hidden="true">·</span>
          <button type="button" data-set-lang="fr" lang="fr" aria-label="Français">FR</button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap hero-inner">
          <div class="hero-text">
            <h1>{{ t(texts.hero.greeting) }}</h1>
            <p class="lead">{{ t(texts.hero.intro) }}</p>
            <div class="actions">
              <a class="btn btn-primary" href="#support">{{ t(texts.hero.support) }}</a>
              <a class="btn btn-ghost" href="#tools">{{ t(texts.hero.see) }}</a>
            </div>
            <p class="supporters">{{ t(texts.supporters) }}</p>
          </div>
        </div>
        <picture class="hero-photo">
          <source srcset="/assets/images/jeremy.webp" type="image/webp"/>
          <img src="/assets/images/jeremy.jpg" width="457" height="1064" alt="{{ texts.hero.photoAlt.en }}" fetchpriority="high"/>
        </picture>
      </section>

      <section id="tools" class="band">
        <div class="wrap split">
          <div class="stack">
            <h2>{{ t(texts.tools.title) }}</h2>
            <p class="body-lg">{{ t(texts.tools.intro) }}</p>
            <a class="text-link" href="{{ texts.tools.toolboxUrl }}" target="_blank" rel="noopener">{{ t(texts.tools.toolbox) }} {{ ext() }}</a>
          </div>
          <ul class="cards">
            {%- for tool in tools %}
            <li>
              <a class="card" href="{{ tool.url }}" target="_blank" rel="noopener">
                <img class="card-icon" src="/assets/images/{{ tool.id }}-icon.webp" alt="" width="44" height="44" loading="lazy">
                <strong>{{ tool.name }}</strong>
                <span>{{ t(tool.description) }}</span>
              </a>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </section>

      <section id="apps" class="section wrap">
        <div class="section-head">
          <h2>{{ t(texts.apps.title) }}</h2>
          <p class="body-lg">{{ t(texts.apps.intro) }}</p>
        </div>
        <ul class="rows rows-apps">
          {%- for app in apps %}
          <li>
            <a class="row" href="{{ app.url }}" target="_blank" rel="noopener">
              <img class="app-icon" src="{{ app.icon }}" width="56" height="56" alt="" loading="lazy"/>
              <span class="row-text">
                <strong>{{ app.name }}</strong>
                <span>{{ t(app.description) }}</span>
              </span>
            </a>
          </li>
          {%- endfor %}
        </ul>
      </section>

      <section id="work" class="band band-grey">
        <div class="wrap section">
          <div class="section-head">
            <h2>{{ t(texts.work.title) }}</h2>
            <p class="body-lg">{{ t(texts.work.intro) }}</p>
          </div>
          <ul class="rows rows-work">
            {%- for site in websites %}
            <li class="work-item">
              <img class="logo" src="{{ site.icon }}" width="48" height="48" alt="" loading="lazy"/>
              <div class="row-text">
                <strong>{{ site.name }}</strong>
                <span>{{ t(site.description) }}</span>
                <span class="muted">{{ t(site.contribution) }}</span>
                <a class="text-link small" href="{{ site.url }}" target="_blank" rel="noopener">{{ t(texts.work.visit) }}<span class="sr"> {{ site.name }}</span> {{ ext() }}</a>
              </div>
            </li>
            {%- endfor %}
          </ul>
        </div>
      </section>

      <section id="support" class="section wrap support">
        <div class="stack support-text">
          <h2 class="h2-xl">{{ t(texts.support.title) }}</h2>
          <p class="body-lg">{{ t(texts.support.text) }}</p>
          <p class="supporters">{{ t(texts.supporters) }}</p>
        </div>
        <div class="support-actions">
          <a class="btn btn-primary btn-block" href="{{ texts.support.giveUrl }}" target="_blank" rel="noopener">{{ t(texts.support.give) }}</a>
          <a class="btn btn-ghost btn-block" href="https://github.com/sponsors/jerefrer" target="_blank" rel="noopener">{{ t(texts.support.github) }}</a>
          <p class="paypal">{{ t(texts.support.paypal) }} <a href="https://paypal.me/frerejeremy108" target="_blank" rel="noopener">PayPal {{ ext() }}</a></p>
          <details class="write" id="contact">
            <summary>{{ t(texts.support.write) }}</summary>
            <form method="POST" action="https://formspree.io/f/xpwzqkzn" class="form">
              <div class="field">
                <label for="name">{{ t(texts.contact.name) }}</label>
                <input type="text" name="name" id="name" autocomplete="name" required/>
              </div>
              <div class="field">
                <label for="email">{{ t(texts.contact.email) }}</label>
                <input type="email" name="email" id="email" autocomplete="email" required/>
              </div>
              <div class="field">
                <label for="message">{{ t(texts.contact.message) }}</label>
                <textarea name="message" id="message" rows="5" required></textarea>
              </div>
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="trap" aria-hidden="true"/>
              <button type="submit" class="btn btn-primary">{{ t(texts.contact.send) }}</button>
            </form>
          </details>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>{{ t(texts.footer.made) }} <a href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a> {{ t(texts.footer.suffix) }}</span>
        <span class="footer-links">
          <a href="https://github.com/jerefrer" target="_blank" rel="noopener">GitHub</a>
          <a href="https://github.com/sponsors/jerefrer" target="_blank" rel="noopener">GitHub Sponsors</a>
          <a href="{{ texts.tools.toolboxUrl }}" target="_blank" rel="noopener">{{ t(texts.footer.toolbox) }}</a>
        </span>
      </div>
    </footer>

    <script src="/assets/js/site.js" defer></script>
  </body>
</html>
